<file path="src/pages/index.astro">
---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';

// Grab up to 3 featured items from products.json for the homepage preview
const featuredProducts = products.slice(0, 3);
---

<Layout title="DesiFit | Modern South Asian Fashion & Lookbook">
  <main class="max-w-7xl mx-auto px-4 py-8 font-sans">
    
    <!-- Hero Section -->
    <section class="text-center py-12 px-4 bg-gray-50 rounded-2xl mb-12 border border-gray-100">
      <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
        Curated Style Guide
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 my-4 leading-tight">
        Elevate Your Wardrobe with Modern Desi Elegance
      </h1>
      <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto mb-8 leading-relaxed">
        Discover handpicked ethnic wear, fusion silhouettes, and statement accessories tailored for modern everyday style.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a 
          href="/categories/indo-western" 
          class="bg-gray-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition shadow-sm"
        >
          Explore Indo-Western &rarr;
        </a>
        <a 
          href="/categories/desi-casual" 
          class="bg-white text-gray-900 border border-gray-300 px-6 py-3 rounded-lg font-semibold hover:bg-gray-50 transition"
        >
          Shop Desi Casual
        </a>
      </div>
    </section>

    <!-- Category Quick Links -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Browse by Category</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <a href="/categories/indo-western" class="group block text-decoration-none">
          <div class="border border-gray-200 rounded-xl p-6 text-center bg-white shadow-sm hover:border-indigo-300 hover:shadow-md transition">
            <div class="text-3xl mb-2">💃</div>
            <h3 class="text-xl font-bold text-gray-900 mb-1 group-hover:text-indigo-600 transition">Indo-Western Fusion</h3>
            <p class="text-sm text-gray-500">Short Kurtis, Fusion Sets & Boho Wear</p>
          </div>
        </a>

        <a href="/categories/desi-casual" class="group block text-decoration-none">
          <div class="border border-gray-200 rounded-xl p-6 text-center bg-white shadow-sm hover:border-indigo-300 hover:shadow-md transition">
            <div class="text-3xl mb-2">✨</div>
            <h3 class="text-xl font-bold text-gray-900 mb-1 group-hover:text-indigo-600 transition">Desi Casual & Everyday</h3>
            <p class="text-sm text-gray-500">Daily Cotton Kurtas & Workwear</p>
          </div>
        </a>

        <a href="/categories/jewelry-accessories" class="group block text-decoration-none">
          <div class="border border-gray-200 rounded-xl p-6 text-center bg-white shadow-sm hover:border-indigo-300 hover:shadow-md transition">
            <div class="text-3xl mb-2">💍</div>
            <h3 class="text-xl font-bold text-gray-900 mb-1 group-hover:text-indigo-600 transition">Jewelry & Accessories</h3>
            <p class="text-sm text-gray-500">Oxidized Statements & Minimal Jewelry</p>
          </div>
        </a>

      </div>
    </section>

    <!-- Featured Trends Grid -->
    <section>
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Featured Looks</h2>
        <a href="/categories" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">
          View All Categories &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProducts.map((product) => (
          <article class="border border-gray-200 rounded-xl overflow-hidden bg-white shadow-sm flex flex-col justify-between">
            <div>
              <div class="relative w-full h-80 bg-gray-50">
                {product.image && (
                  <img 
                    src={product.image} 
                    alt={product.name || product.title} 
                    class="w-full h-full object-cover" 
                  />
                )}
                {product.brand && (
                  <span class="absolute top-3 left-3 bg-gray-900 text-white text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">
                    {product.brand}
                  </span>
                )}
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-lg text-gray-800 line-clamp-1">{product.name || product.title}</h3>
                {product.price && <p class="text-gray-900 font-bold mt-1">₹{product.price}</p>}
              </div>
            </div>

            <div class="p-4 pt-0">
              {product.affiliateUrl && (
                <a 
                  href={product.affiliateUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="block text-center bg-indigo-600 text-white font-medium py-2.5 px-4 rounded-lg hover:bg-indigo-700 transition"
                >
                  Shop This Look &rarr;
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

  </main>
</Layout>
</file>

