---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DesiFit | Fashion Lookbooks & Fitness Studio",
  description = "Curated women’s and men’s desi fashion lookbooks plus a lean fitness studio with BMI and Desi food calorie tools.",
} = Astro.props;

const studios = [
  { label: "Women", href: "/categories" },
  { label: "Men", href: "/categories/mens" },
  { label: "Fitness", href: "/fitness" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GB549ENN8E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-GB549ENN8E");
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="mitgo-verification" content="e6f56535-e820-4ae2-a0ee-3a1688da48da" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://desifit.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://desifit.com/og-default.svg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
        <a href="/" class="font-display text-2xl font-extrabold tracking-tight text-ink md:text-[1.75rem]">
          DesiFit<span class="text-accent">.</span>
        </a>
        <nav class="hidden items-center gap-5 text-sm font-semibold text-ink-soft md:flex">
          {studios.map((s) => (
            <a href={s.href} class="transition hover:text-accent">
              {s.label}
            </a>
          ))}
          <a href="/categories" class="rounded-full bg-ink px-3 py-1.5 text-paper transition hover:bg-accent">
            Lookbooks
          </a>
        </nav>
        <div class="flex items-center gap-3 md:hidden">
          <a href="/fitness" class="text-sm font-semibold text-ink-soft">Fitness</a>
          <a href="/categories" class="text-sm font-semibold text-accent">Lookbooks</a>
        </div>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="mt-16 border-t border-line bg-ink text-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-[1.4fr_1fr] md:px-6">
        <div>
          <p class="font-display text-3xl font-bold">DesiFit<span class="text-accent">.</span></p>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/70">
            Women’s and men’s curated lookbooks, plus a lean fitness studio — lifestyle doors with real shoppable pieces where it matters.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-6 text-sm">
          <div class="space-y-2">
            <p class="font-semibold uppercase tracking-wider text-paper/50">Studios</p>
            <a class="block text-paper/85 hover:text-accent" href="/categories">Women</a>
            <a class="block text-paper/85 hover:text-accent" href="/categories/mens">Men</a>
            <a class="block text-paper/85 hover:text-accent" href="/fitness">Fitness</a>
            <a class="block text-paper/85 hover:text-accent" href="/categories">All lookbooks</a>
          </div>
          <div class="space-y-2">
            <p class="font-semibold uppercase tracking-wider text-paper/50">Site</p>
            <a class="block text-paper/85 hover:text-accent" href="/about">About</a>
            <a class="block text-paper/85 hover:text-accent" href="/contact">Contact</a>
            <a class="block text-paper/85 hover:text-accent" href="/disclosure">Affiliate disclosure</a>
            <a class="block text-paper/85 hover:text-accent" href="/privacy">Privacy</a>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-paper/50 md:px-6">
        © {new Date().getFullYear()} DesiFit. As an Admitad affiliate, we may earn from qualifying purchases.
      </div>
    </footer>
  </body>
</html>
