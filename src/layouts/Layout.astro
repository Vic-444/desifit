---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DesiFit | Desi outfit inspiration",
  description = "Scroll desi outfit inspiration — full looks you can shop. Women’s ethnic and everyday style from partner merchants.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GB549ENN8E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-GB549ENN8E");
    </script>
    <!-- AdSense placeholder: uncomment when approved
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="mitgo-verification" content="e6f56535-e820-4ae2-a0ee-3a1688da48da" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://desifit.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://desifit.com/images/brand/og.jpg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://desifit.com/images/brand/og.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-3 py-2 md:px-6 md:py-2.5">
        <a href="/" class="font-display text-xl font-extrabold tracking-tight text-ink md:text-2xl">
          DesiFit<span class="text-accent">.</span>
        </a>
        <nav class="flex items-center gap-4 text-sm font-semibold text-ink-soft">
          <a href="/" class="transition hover:text-accent">Looks</a>
          <a href="/blog" class="transition hover:text-accent">Blog</a>
          <a href="/about" class="hidden transition hover:text-accent sm:inline">About</a>
        </nav>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="mt-10 border-t border-line bg-ink text-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-[1.4fr_1fr] md:px-6">
        <div>
          <p class="font-display text-2xl font-bold">DesiFit<span class="text-accent">.</span></p>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-paper/70">
            Women’s desi outfit inspiration — a visual wall of full looks you can shop through partner merchants.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-6 text-sm">
          <div class="space-y-2">
            <p class="font-semibold uppercase tracking-wider text-paper/50">Explore</p>
            <a class="block text-paper/85 hover:text-accent" href="/">Looks</a>
            <a class="block text-paper/85 hover:text-accent" href="/blog">Blog</a>
            <a class="block text-paper/85 hover:text-accent" href="/about">About</a>
          </div>
          <div class="space-y-2">
            <p class="font-semibold uppercase tracking-wider text-paper/50">Site</p>
            <a class="block text-paper/85 hover:text-accent" href="/contact">Contact</a>
            <a class="block text-paper/85 hover:text-accent" href="/disclosure">Affiliate disclosure</a>
            <a class="block text-paper/85 hover:text-accent" href="/privacy">Privacy</a>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-paper/50 md:px-6">
        © {new Date().getFullYear()} DesiFit. As an Admitad affiliate, we may earn from qualifying purchases.
      </div>
    </footer>
  </body>
</html>
