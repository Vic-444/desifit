---
import Layout from "../layouts/Layout.astro";
import { assertUniqueWallImages, wallLooks } from "../data/wall";

assertUniqueWallImages(wallLooks);
/** Base order from JSON — midweek rotate runs in the browser (IST). */
const looks = wallLooks;
const looksJson = JSON.stringify(looks);
---

<Layout
  title="DesiFit | Desi outfit inspiration"
  description="Scroll desi outfit inspiration — full looks you can shop. Women’s ethnic and everyday style from partner merchants."
>
  <main class="wall-page">
    <div class="wall-grid" id="wall-grid" aria-label="Outfit inspiration wall">
      {
        looks.map((look, index) => (
          <button
            type="button"
            class="wall-tile"
            data-index={index}
            data-look-id={look.id}
            id={`look-${look.id}`}
            aria-label={`Open look: ${look.title}`}
          >
            <img
              src={look.image}
              alt=""
              loading={index < 9 ? "eager" : "lazy"}
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </button>
        ))
      }
    </div>
  </main>

  <div
    id="look-lightbox"
    class="lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
  >
    <div class="lightbox-backdrop" data-close></div>
    <div class="lightbox-panel">
      <button type="button" class="lightbox-close" data-close aria-label="Close">✕</button>
      <button type="button" class="lightbox-nav lightbox-prev" data-prev aria-label="Previous look">‹</button>
      <button type="button" class="lightbox-nav lightbox-next" data-next aria-label="Next look">›</button>

      <div class="lightbox-body">
        <div class="lightbox-hero">
          <img id="lightbox-image" src="" alt="" referrerpolicy="no-referrer" />
        </div>
        <div class="lightbox-copy">
          <h2 id="lightbox-title" class="font-display text-2xl font-bold text-ink md:text-3xl"></h2>
          <p id="lightbox-desc" class="mt-3 text-sm leading-relaxed text-ink-soft md:text-base"></p>
          <ul id="lightbox-items" class="lightbox-items"></ul>
        </div>
      </div>
    </div>
  </div>

  <script id="wall-data" type="application/json" set:html={looksJson} />
  <script is:inline>
    const baseLooks = JSON.parse(document.getElementById("wall-data").textContent || "[]");

    function istDay() {
      return new Date(new Date().toLocaleString("en-US", { timeZone: "Asia/Kolkata" })).getDay();
    }

    /** Wed–Sat IST: bottom 10 → top */
    function displayLooks(list) {
      if (list.length < 10) return list.slice();
      const day = istDay();
      if (day < 3 || day > 6) return list.slice();
      const n = 10;
      return list.slice(-n).concat(list.slice(0, -n));
    }

    let looks = displayLooks(baseLooks);
    const grid = document.getElementById("wall-grid");

    // Reorder DOM to match midweek display order
    if (grid && looks.length) {
      const byId = new Map(
        Array.from(grid.querySelectorAll(".wall-tile")).map((el) => [el.getAttribute("data-look-id"), el])
      );
      looks.forEach((look, index) => {
        const tile = byId.get(look.id);
        if (!tile) return;
        tile.dataset.index = String(index);
        grid.appendChild(tile);
      });
    }

    const lightbox = document.getElementById("look-lightbox");
    const titleEl = document.getElementById("lightbox-title");
    const descEl = document.getElementById("lightbox-desc");
    const imageEl = document.getElementById("lightbox-image");
    const itemsEl = document.getElementById("lightbox-items");
    let current = 0;

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function renderItem(item) {
      const priceBlock = item.mrp
        ? `<span class="price-row"><span class="price-mrp">${escapeHtml(item.mrp)}</span><span class="price-sale">${escapeHtml(item.price)}</span></span>`
        : `<span class="price-sale">${escapeHtml(item.price)}</span>`;
      return `<li class="lightbox-item">
        <img src="${escapeHtml(item.imageUrl)}" alt="" loading="lazy" referrerpolicy="no-referrer" />
        <div class="lightbox-item-meta">
          <p class="item-brand">${escapeHtml(item.brand)}</p>
          <p class="item-name">${escapeHtml(item.name)}</p>
          ${priceBlock}
          <a class="shop-cta" href="${escapeHtml(item.affiliateUrl)}" target="_blank" rel="noopener sponsored">Shop at ${escapeHtml(item.brand)}</a>
        </div>
      </li>`;
    }

    function openAt(index) {
      if (!looks.length) return;
      current = ((index % looks.length) + looks.length) % looks.length;
      const look = looks[current];
      titleEl.textContent = look.title;
      descEl.textContent = look.description;
      imageEl.src = look.image;
      imageEl.alt = look.title;
      itemsEl.innerHTML = look.items.map(renderItem).join("");
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      history.replaceState(null, "", "#look-" + look.id);
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = "";
      if (location.hash.indexOf("#look-") === 0) {
        history.replaceState(null, "", location.pathname);
      }
    }

    grid?.addEventListener("click", (e) => {
      const tile = e.target.closest("[data-index]");
      if (!tile) return;
      openAt(Number(tile.dataset.index));
    });

    lightbox?.querySelectorAll("[data-close]").forEach((el) => {
      el.addEventListener("click", closeLightbox);
    });
    lightbox?.querySelector("[data-prev]")?.addEventListener("click", () => openAt(current - 1));
    lightbox?.querySelector("[data-next]")?.addEventListener("click", () => openAt(current + 1));

    document.addEventListener("keydown", (e) => {
      if (lightbox.hidden) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") openAt(current - 1);
      if (e.key === "ArrowRight") openAt(current + 1);
    });

    let touchX = null;
    lightbox?.querySelector(".lightbox-panel")?.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );
    lightbox?.querySelector(".lightbox-panel")?.addEventListener(
      "touchend",
      (e) => {
        if (touchX == null) return;
        const dx = e.changedTouches[0].screenX - touchX;
        touchX = null;
        if (Math.abs(dx) < 50) return;
        if (dx > 0) openAt(current - 1);
        else openAt(current + 1);
      },
      { passive: true }
    );

    const hash = location.hash.replace(/^#/, "");
    if (hash.indexOf("look-") === 0) {
      const id = hash.slice(5);
      const idx = looks.findIndex((l) => l.id === id);
      if (idx >= 0) openAt(idx);
    }
  </script>
</Layout>
