---
import Layout from "../layouts/Layout.astro";
import LookCard from "../components/LookCard.astro";
import data from "../data/looks.json";

/** Pick up to `count` featured looks with unique card images.
 *  Prefers the first look in each subcategory; if that image was
 *  already used (same shared top), fall back to another item photo
 *  in the look, then try later looks in the same subcategory. */
function pickFeatured(count = 6) {
  const usedImages = new Set<string>();
  const featured: Array<{
    id: string;
    title: string;
    image: string;
    items: (typeof data.categories)[0]["subcategories"][0]["looks"][0]["items"];
    categoryTitle: string;
    categoryId: string;
    subcategoryId: string;
  }> = [];

  for (const cat of data.categories) {
    for (const sub of cat.subcategories) {
      if (featured.length >= count) break;

      let picked:
        | {
            id: string;
            title: string;
            image: string;
            items: (typeof sub.looks)[0]["items"];
          }
        | undefined;

      for (const look of sub.looks) {
        if (look.image && !usedImages.has(look.image)) {
          picked = { ...look, image: look.image };
          break;
        }
        const alt = look.items.find(
          (item) => item.imageUrl && !usedImages.has(item.imageUrl)
        );
        if (alt?.imageUrl) {
          picked = { ...look, image: alt.imageUrl };
          break;
        }
      }

      if (!picked && sub.looks[0]) {
        picked = { ...sub.looks[0], image: sub.looks[0].image };
      }
      if (!picked?.image) continue;

      usedImages.add(picked.image);
      featured.push({
        ...picked,
        categoryTitle: cat.title,
        categoryId: cat.id,
        subcategoryId: sub.id,
      });
    }
  }

  return featured;
}

const featured = pickFeatured(6);

const heroImage =
  data.categories[0]?.subcategories[0]?.looks[0]?.image ||
  "/images/looks/skd-01.svg";
---

<Layout>
  <section class="relative min-h-[88vh] overflow-hidden bg-ink text-paper">
    <img
      src={heroImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-45 animate-fade"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-ink/35"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(230,57,70,0.28),transparent_42%)]"></div>

    <div class="relative mx-auto flex min-h-[88vh] max-w-6xl flex-col justify-end px-4 pb-16 pt-28 md:px-6 md:pb-20">
      <p class="animate-rise font-display text-5xl font-extrabold tracking-tight md:text-7xl lg:text-8xl">
        DesiFit<span class="text-accent">.</span>
      </p>
      <h1 class="animate-rise delay-1 mt-4 max-w-2xl font-display text-2xl font-semibold leading-tight text-paper/95 md:text-4xl">
        Curated desi looks. Real products. One click to shop.
      </h1>
      <p class="animate-rise delay-2 mt-4 max-w-xl text-base leading-relaxed text-paper/75 md:text-lg">
        Indo-Western, everyday ethnic, and accessories — handpicked outfits with deep links to Bewakoof, BlissClub, and Salty.
      </p>
      <div class="animate-rise delay-3 mt-8 flex flex-wrap gap-3">
        <a
          href="/categories/indo-western"
          class="rounded-full bg-accent px-6 py-3 text-sm font-bold text-white transition hover:bg-accent-deep"
        >
          Browse Indo-Western
        </a>
        <a
          href="/categories"
          class="rounded-full border border-paper/40 px-6 py-3 text-sm font-bold text-paper transition hover:bg-paper/10"
        >
          All lookbooks
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <div class="mb-8 max-w-2xl">
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">Three worlds. Ninety looks.</h2>
      <p class="mt-3 text-ink-soft">Each look is a curated outfit with shoppable pieces — not category dumps.</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {data.categories.map((cat, idx) => (
        <a
          href={`/categories/${cat.id}`}
          class:list={[
            "group relative overflow-hidden rounded-3xl border border-line p-6 transition hover:-translate-y-1",
            idx === 0 ? "bg-ink text-paper" : "bg-white text-ink",
          ]}
        >
          <p class="text-xs font-semibold uppercase tracking-[0.16em] opacity-60">
            {cat.subcategories.length} subcategories
          </p>
          <h3 class="mt-3 font-display text-2xl font-bold">{cat.title}</h3>
          <p class:list={["mt-3 text-sm leading-relaxed", idx === 0 ? "text-paper/70" : "text-ink-soft"]}>
            {cat.description}
          </p>
          <span class:list={["mt-6 inline-block text-sm font-semibold", idx === 0 ? "text-accent" : "text-accent-deep"]}>
            Explore →
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-line bg-paper-2/60">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl font-bold text-ink">Featured looks</h2>
          <p class="mt-2 text-ink-soft">A taste from each lookbook.</p>
        </div>
        <a href="/categories" class="hidden text-sm font-semibold text-accent-deep md:inline">View all →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((look) => (
          <LookCard
            id={look.id}
            title={look.title}
            image={look.image}
            items={look.items}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
