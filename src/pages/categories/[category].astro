---
import Layout from "../../layouts/Layout.astro";
import LookCard from "../../components/LookCard.astro";
import data from "../../data/looks.json";

export function getStaticPaths() {
  return data.categories.map((cat) => ({
    params: { category: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const previewLooks = category.subcategories.flatMap((sub) =>
  sub.looks.slice(0, 2).map((look) => look)
);
---

<Layout title={`${category.title} | DesiFit`} description={category.description}>
  <main class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <a href="/categories" class="text-sm font-semibold text-accent-deep">← All lookbooks</a>
    <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">{category.title}</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">{category.description}</p>

    <section class="mt-10 grid gap-4 md:grid-cols-3">
      {category.subcategories.map((sub) => (
        <a
          href={`/categories/${category.id}/${sub.id}`}
          class="rounded-3xl border border-line bg-white p-5 transition hover:-translate-y-0.5 hover:border-accent/40"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sand">{sub.looks.length} looks</p>
          <h2 class="mt-2 font-display text-xl font-bold text-ink">{sub.title}</h2>
          <p class="mt-2 text-sm text-ink-soft">{sub.description}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-accent-deep">Open lookbook →</span>
        </a>
      ))}
    </section>

    <section class="mt-14">
      <h2 class="font-display text-2xl font-bold text-ink">Preview looks</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {previewLooks.map((look) => (
          <LookCard
            id={look.id}
            title={look.title}
            image={look.cardImage || look.image}
            imageSecondary={look.cardImageSecondary}
            items={look.items}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
