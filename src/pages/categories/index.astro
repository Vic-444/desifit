---
import Layout from "../../layouts/Layout.astro";
import data from "../../data/looks.json";
---

<Layout title="Lookbooks | DesiFit" description="Browse all DesiFit curated fashion lookbooks.">
  <main class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <h1 class="font-display text-4xl font-bold text-ink md:text-5xl">Lookbooks</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      3 categories · 9 subcategories · 90 curated looks with real merchant product links.
    </p>

    <div class="mt-12 space-y-10">
      {data.categories.map((cat) => (
        <section class="rounded-3xl border border-line bg-white p-6 md:p-8">
          <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <h2 class="font-display text-2xl font-bold text-ink md:text-3xl">{cat.title}</h2>
              <p class="mt-2 max-w-2xl text-sm text-ink-soft">{cat.description}</p>
            </div>
            <a href={`/categories/${cat.id}`} class="text-sm font-semibold text-accent-deep">
              Open category →
            </a>
          </div>
          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            {cat.subcategories.map((sub) => (
              <a
                href={`/categories/${cat.id}/${sub.id}`}
                class="rounded-2xl border border-line bg-paper px-4 py-4 transition hover:border-accent/40 hover:bg-paper-2"
              >
                <p class="font-semibold text-ink">{sub.title}</p>
                <p class="mt-1 text-xs text-ink-soft">{sub.looks.length} looks</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>
