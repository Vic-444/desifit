---
import Layout from "../../layouts/Layout.astro";
import data from "../../data/looks.json";

export function getStaticPaths() {
  return data.categories.flatMap((cat) =>
    cat.subcategories.flatMap((sub) =>
      sub.looks.map((look) => ({
        params: { id: look.id },
        props: {
          look,
          category: cat,
          subcategory: sub,
        },
      }))
    )
  );
}

const { look, category, subcategory } = Astro.props;
const brands = [...new Set(look.items.map((i) => i.brand))].join(" · ");
---

<Layout title={`${look.title} | DesiFit`} description={`Shop the ${look.title} look on DesiFit.`}>
  <main class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
      <a href={`/categories/${category.id}/${subcategory.id}`} class="font-semibold text-accent-deep">
        ← {subcategory.title}
      </a>
    </div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="overflow-hidden rounded-3xl border border-line bg-paper-2">
        <img
          src={look.image}
          alt={look.title}
          class="aspect-[4/5] w-full object-cover"
          referrerpolicy="no-referrer"
        />
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sand">{brands}</p>
        <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-ink md:text-4xl">{look.title}</h1>
        <p class="mt-3 text-ink-soft">
          Every piece below links to the merchant product page via Admitad tracking.
        </p>

        <div class="mt-8 space-y-4">
          {look.items.map((item) => (
            <article class="flex gap-4 rounded-2xl border border-line bg-white p-3">
              <div class="h-24 w-20 shrink-0 overflow-hidden rounded-xl bg-paper-2">
                {item.imageUrl ? (
                  <img
                    src={item.imageUrl}
                    alt={item.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  />
                ) : null}
              </div>
              <div class="flex min-w-0 flex-1 flex-col justify-between py-0.5">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-sand">{item.brand}</p>
                  <h2 class="mt-1 truncate font-semibold text-ink">{item.name}</h2>
                  <p class="mt-1 text-sm font-bold text-ink">{item.price}</p>
                </div>
                <a
                  href={item.affiliateUrl}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="shop-cta mt-2"
                >
                  Shop at {item.brand} →
                </a>
              </div>
            </article>
          ))}
        </div>

        <p class="mt-6 text-xs leading-relaxed text-ink-soft">
          DesiFit is an Admitad affiliate. We may earn a commission if you buy through these links, at no extra cost to you.
          See our <a class="underline" href="/disclosure">affiliate disclosure</a>.
        </p>
      </div>
    </div>
  </main>
</Layout>
