    <h3>Get in touch</h3>
    <ul>
      <li><strong>Email:</strong> <a href="mailto:hello@desifit.com">hello@desifit.com</a></li>
      <li><strong>Website:</strong> <a href="https://desifit.com">desifit.com</a></li>
    </ul>
    <p>We aim to reply within 24–48 business hours.</p>
  </main>
</Layout>
