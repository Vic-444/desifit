---
import Layout from "../../layouts/Layout.astro";
import { getLiveWeeklyPosts } from "../../data/weekly-posts";

const posts = getLiveWeeklyPosts();
---

<Layout
  title="Weekly Looks | DesiFit"
  description="DesiFit Weekly Looks — editorial guides to each week’s fusion, street, and desi casual outfits, with videos and shoppable links."
>
  <main class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sand">On site</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink md:text-5xl">Weekly looks</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink-soft">
      Each week we break down three outfits — what works, when to wear them, and where to shop every piece. Videos included; the writing is the point.
    </p>

    {posts.length === 0 ? (
      <p class="mt-12 border-b border-line pb-8 text-ink-soft">
        The first weekly look lands soon. Meanwhile, browse the
        <a href="/categories" class="font-semibold text-accent-deep underline-offset-2 hover:underline">lookbooks</a>.
      </p>
    ) : (
      <ul class="mt-12 space-y-6">
        {posts.map((post) => (
          <li>
            <a
              href={`/weekly-looks/${post.slug}`}
              class="group block border-b border-line pb-6 transition hover:border-accent"
            >
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sand">
                {new Date(post.publishAt).toLocaleDateString("en-IN", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                  timeZone: "Asia/Kolkata",
                })}
              </p>
              <h2 class="mt-2 font-display text-2xl font-bold text-ink group-hover:text-accent-deep md:text-3xl">
                {post.title}
              </h2>
              <p class="mt-2 text-ink-soft">{post.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
